## Reconciles a Finance Office Excel workbook (.xlsx) against Postgres donor gift
## records using custom `tag donor` and exact Decimal balance-conservation promises.
module DonorReconciliation

tag donor

schema FinanceSheetGift
  receipt_no: Text
  donor_name: Text [pii, donor]
  fund_code: Text
  gift_date: Date
  amount: Decimal [financial, donor] where . > 0
end

schema DbGift
  receipt_no: Text
  donor_id: Int [pii, donor]
  fund_code: Text
  gift_date: Date
  amount: Decimal [financial, donor]
end

struct ReconciliationResult
  matched_count: Int [financial, donor]
  matched_total: Decimal [financial, donor]
  amount_mismatches: Table(
    receipt_no: Text,
    fund_code: Text,
    sheet_amount: Decimal [financial, donor],
    db_amount: Decimal [financial, donor],
    delta: Decimal [financial, donor]
  )
  only_in_sheet: Table(receipt_no: Text, fund_code: Text, amount: Decimal [financial, donor])
  only_in_db: Table(receipt_no: Text, fund_code: Text, amount: Decimal [financial, donor])
end

fn reconcile(sheet: Table(FinanceSheetGift), db_gifts: Table(DbGift)) : ReconciliationResult
  # Drop donor names/IDs immediately so reconciliation outputs carry zero [pii].
  s = sheet |> select(.receipt_no, .fund_code, .amount)
  d = db_gifts |> select(.receipt_no, .fund_code, .amount)

  joined = s |> join_one(d, on: .receipt_no, suffixes: ("_sheet", "_db"))

  matched = joined |> where(.amount_sheet == .amount_db)

  mismatches = joined
    |> where(.amount_sheet != .amount_db)
    |> derive(delta: .amount_sheet - .amount_db)
    |> select(
         .receipt_no,
         fund_code: .fund_code_sheet,
         sheet_amount: .amount_sheet,
         db_amount: .amount_db,
         .delta
       )

  only_sheet = s |> anti_join(d, on: .receipt_no)
  only_db = d |> anti_join(s, on: .receipt_no)

  # Exact Decimal conservation check: every cent in the spreadsheet is accounted for.
  assert (matched.sum(.amount_sheet) + mismatches.sum(.sheet_amount) + only_sheet.sum(.amount))
    == s.sum(.amount)

  ReconciliationResult(
    matched_count: matched.count(),
    matched_total: matched.sum(.amount_sheet),
    amount_mismatches: mismatches,
    only_in_sheet: only_sheet,
    only_in_db: only_db
  )
end

fn main(
  args: Args,
  files: ReadFiles,
  db: ReadDB(Seminary),
  out: WriteFiles("finance-audit/", allows: [donor, financial]),
  console: Console
) : Int
  path = args.first.or_return(2)
  (sheet, bad_rows) = try files.read_xlsx(path, sheet: "Gifts", as: FinanceSheetGift)

  for bad in bad_rows
    console.error("row #{bad.line}, col #{bad.column}: #{bad.error_kind}")
  end

  res = reconcile(sheet, db.table(DbGift))

  summary_sheet = table
    | metric            | count                         |
    | "matched"         | res.matched_count             |
    | "amount_mismatch" | res.amount_mismatches.count() |
    | "only_in_sheet"   | res.only_in_sheet.count()     |
    | "only_in_db"      | res.only_in_db.count()        |
  end

  # Note: `matched_count` and `amount_mismatches.count()` carry [donor, financial] via
  # implicit flow (`where(.amount_sheet == .amount_db)`), so they write cleanly into the
  # authorized `finance-audit/` workbook rather than leaking to plain public `Console`.
  try out.write_xlsx(
    "reconciliation-report.xlsx",
    sheets: {
      "Summary": summary_sheet,
      "AmountMismatches": res.amount_mismatches,
      "OnlyInSpreadsheet": res.only_in_sheet,
      "OnlyInDatabase": res.only_in_db
    }
  )

  # `sheet.count()` and `bad_rows.count()` did not filter on [donor, financial] -> public!
  console.print("Reconciled #{sheet.count()} spreadsheet rows (#{bad_rows.count()} malformed).")
  console.print("Wrote finance-audit/reconciliation-report.xlsx")
  if bad_rows.empty?: 0 else: 1
end

test "reconciliation catches amount drift and missing receipts with exact Decimal math"
  sheet = table
    | receipt_no | donor_name | fund_code | gift_date  | amount |
    | "R-100"    | "A. Smith" | "GEN"     | 2026-10-01 | 250.00 |
    | "R-101"    | "B. Jones" | "SCHOL"   | 2026-10-02 | 100.50 |
    | "R-102"    | "C. Lee"   | "GEN"     | 2026-10-03 |  75.25 |
  end
  db_gifts = table
    | receipt_no | donor_id | fund_code | gift_date  | amount |
    | "R-100"    | 1        | "GEN"     | 2026-10-01 | 250.00 |
    | "R-101"    | 2        | "SCHOL"   | 2026-10-02 | 100.00 |
    | "R-103"    | 3        | "BLDG"    | 2026-10-04 | 500.00 |
  end

  res = reconcile(sheet, db_gifts)
  assert res.matched_count == 1
  assert res.matched_total == 250.00
  assert res.amount_mismatches.count() == 1
  assert res.amount_mismatches.first!.delta == 0.50
  assert res.only_in_sheet.count() == 1
  assert res.only_in_db.count() == 1
end
