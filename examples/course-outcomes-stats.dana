## Exploratory statistical analysis of public course-section engagement vs. completion.
##
## Exercises Dana's built-in stats stdlib (profile, correlation, linear regression,
## t-test, z-score outliers), unified T? missing values, and SVG scatter charts.
module CourseOutcomesStats
use Stats

schema SectionOutcome
  section_id: Text
  modality: Text                   # "in-person" or "online"
  enrolled: Int where . > 0
  avg_weekly_hours: Float?         # missing for uninstrumented sections
  completion_rate: Float where . >= 0.0 and . <= 1.0
end

fn flag_outliers(rows: Table(SectionOutcome))
  clean = rows |> where(.avg_weekly_hours.some?)
  mu = clean.mean(.completion_rate) ?? 0.0
  sd = clean.stddev(.completion_rate) ?? 1.0

  clean
    |> derive(
         z_score: (.completion_rate - mu) / sd,
         outlier?: ((.completion_rate - mu) / sd).abs >= 2.0
       )
end

fn main(files: ReadFiles, out: WriteFiles("reports/"), console: Console) : Int
  rows = try files.read_parquet("data/section-outcomes.parquet", as: SectionOutcome)

  # One-line dataset profile right in the terminal (types, null %, percentiles, sparklines).
  console.print_profile(rows.profile())

  analyzed = flag_outliers(rows)

  # Correlation & simple linear regression: weekly engagement hours -> completion rate.
  r = Stats.corr(analyzed, x: .avg_weekly_hours, y: .completion_rate, method: :pearson)
  model = Stats.linear_regression(analyzed, x: .avg_weekly_hours, y: .completion_rate)

  # Two-sample Welch t-test comparing in-person vs. online completion rates.
  in_person = analyzed |> where(.modality == "in-person")
  online = analyzed |> where(.modality == "online")
  ab = Stats.t_test(in_person, online, column: .completion_rate)

  scatter = analyzed
    |> chart_scatter(
         x: .avg_weekly_hours,
         y: .completion_rate,
         color: .modality,
         trendline: model,
         title: "Weekly Engagement vs. Section Completion (r = #{r.round(3)})"
       )

  report = Report.new("Course Section Outcomes Study")
    |> add_summary(
         "Linear fit: completion = #{model.slope.round(4)} * hours + #{model.intercept.round(3)} "
         + "(R^2 = #{model.r_squared.round(3)}). "
         + "In-person vs. online Welch t-test p = #{ab.p_value.round(4)}."
       )
    |> add_chart(scatter)
    |> add_table(analyzed |> where(.outlier?) |> sort_by(.z_score))

  try out.write_html("course-outcomes.html", report)
  console.print("Pearson r=#{r.round(3)}, R^2=#{model.r_squared.round(3)}, t-test p=#{ab.p_value.round(4)}")
  0
end

test "positive linear relationship yields strong correlation and accurate slope"
  sample = table
    | section_id | modality    | enrolled | avg_weekly_hours | completion_rate |
    | "S1"       | "online"    | 20       | 2.0              | 0.60            |
    | "S2"       | "online"    | 22       | 4.0              | 0.70            |
    | "S3"       | "in-person" | 18       | 6.0              | 0.80            |
    | "S4"       | "in-person" | 25       | 8.0              | 0.90            |
    | "S5"       | "online"    | 15       | none             | 0.75            |
  end

  clean = sample |> where(.avg_weekly_hours.some?)
  model = Stats.linear_regression(clean, x: .avg_weekly_hours, y: .completion_rate)

  assert clean.count() == 4
  assert (model.slope - 0.05).abs < 0.0001
  assert (model.intercept - 0.50).abs < 0.0001
  assert model.r_squared > 0.999
end
