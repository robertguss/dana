## HIPAA-safe clinical outcomes summary by department and age band.
##
## Demonstrates that Dana's privacy system generalizes cleanly beyond higher ed:
## built-in [pii] + [health] tags, k >= 10 distinct-patient suppression, and
## explicit protection against single-patient min/max leaks.
module HipaaClinicOutcomes

schema PatientEncounter
  patient_id: Int [pii]
  full_name: Text [pii]
  department: Text
  age_years: Int [health] where . >= 0 and . <= 125
  length_of_stay_days: Decimal [health] where . >= 0
  readmitted_30d?: Bool [health]
end

fn department_outcomes(encounters: Table(PatientEncounter))
  promise unique(.department, .age_group)
  promise all(.patients >= 10)

  # `bucket(...)` maps [health] ages into compile-time-constant labels; row-level
  # `age_group` stays tagged [health] until `suppress_small_groups(min: 10, distinct_by: ...)`
  # proves >= 10 distinct patients share each (department, age_group) bucket.
  encounters
    |> select(.patient_id, .department, .age_years, .length_of_stay_days, .readmitted_30d?)
    |> derive(
         age_group: bucket(.age_years, cuts: [18, 45, 65], labels: ["0-17", "18-44", "45-64", "65+"])
       )
    |> group_by(.department, .age_group)
    |> summarize(
         patients: count_distinct(.patient_id),
         encounters: count(),
         avg_los_days: mean(.length_of_stay_days),
         # Blending dispersion clears under `suppress_small_groups`;
         # order statistics (`median`, `percentile`, `min`, `max`) stay `[health]`.
         stddev_los_days: stddev(.length_of_stay_days),
         readmission_rate: mean(if .readmitted_30d?: 1.0 else: 0.0)
       )
    |> suppress_small_groups(min: 10, distinct_by: .patient_id)
    |> sort_desc(.patients)
end

fn main(
  db: ReadDB(Clinic),
  out: WriteFiles("reports/"),
  console: Console
) : Int
  summary = department_outcomes(db.table(PatientEncounter))

  chart = summary
    |> chart_bar(
         x: .department,
         y: .readmission_rate,
         color: .age_group,
         title: "30-Day Readmission Rate by Department & Age Band (n >= 10 Patients)"
       )

  report = Report.new("Quarterly Clinical Outcomes (HIPAA De-Identified)")
    |> add_summary("Groups with fewer than 10 distinct patients are suppressed.")
    |> add_chart(chart)
    |> add_table(summary)

  try out.write_html("clinical-outcomes.html", report)
  console.print_table(summary)
  0
end

test "department and age-band groups under 10 distinct patients are suppressed"
  # 10 distinct Cardiology patients in the 45-64 band, 2 in Cardiology 65+, 2 in Genetics 18-44
  # -> ONLY ("Cardiology", "45-64") survives!
  rows = table
    | patient_id | full_name | department   | age_years | length_of_stay_days | readmitted_30d? |
    | 1          | "P1"      | "Cardiology" | 62        | 3.0                 | false           |
    | 2          | "P2"      | "Cardiology" | 58        | 4.0                 | true            |
    | 3          | "P3"      | "Cardiology" | 51        | 5.0                 | false           |
    | 4          | "P4"      | "Cardiology" | 64        | 2.0                 | false           |
    | 5          | "P5"      | "Cardiology" | 54        | 3.0                 | false           |
    | 6          | "P6"      | "Cardiology" | 49        | 6.0                 | true            |
    | 7          | "P7"      | "Cardiology" | 53        | 4.0                 | false           |
    | 8          | "P8"      | "Cardiology" | 60        | 3.0                 | false           |
    | 9          | "P9"      | "Cardiology" | 56        | 5.0                 | false           |
    | 10         | "P10"     | "Cardiology" | 61        | 5.0                 | false           |
    | 11         | "P11"     | "Cardiology" | 72        | 4.0                 | false           |
    | 12         | "P12"     | "Cardiology" | 75        | 5.0                 | true            |
    | 13         | "P13"     | "Genetics"   | 34        | 2.0                 | false           |
    | 14         | "P14"     | "Genetics"   | 29        | 1.0                 | false           |
  end

  out = department_outcomes(rows)
  assert out.count() == 1
  assert out.first!.department == "Cardiology"
  assert out.first!.age_group == "45-64"
  assert out.first!.patients == 10
  assert out.first!.avg_los_days == 4.0
end
